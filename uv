private void LoadExpenseReports()
{
    var dgvReports = tabControl.TabPages[1].Controls["dgvReports"] as DataGridView;
    string query = @"
        SELECT 
            e.FullName AS ""Сотрудник"",
            COALESCE(SUM(rd.Amount), 0) AS ""Сумма расходов"",
            COUNT(DISTINCT r.ReportID) AS ""Количество отчетов""
        FROM Employees e
        LEFT JOIN ExpenseReports r ON e.EmployeeID = r.EmployeeID
        LEFT JOIN ReportDetails rd ON r.ReportID = rd.ReportID
        GROUP BY e.EmployeeID, e.FullName
        ORDER BY e.FullName";
    
    dgvReports.DataSource = DatabaseHelper.ExecuteQuery(query);
    dgvReports.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill;
}
