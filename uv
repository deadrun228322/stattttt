using Npgsql;
using System;
using System.Data;
using System.Windows.Forms;

namespace AccountingApp
{
    public static class DatabaseHelper
    {
        private static string connectionString = "Host=localhost;Port=5432;Database=AccountingDB;Username=postgres;Password=your_password;";

        public static NpgsqlConnection GetConnection()
        {
            return new NpgsqlConnection(connectionString);
        }

        public static DataTable ExecuteQuery(string query, NpgsqlParameter[] parameters = null)
        {
            DataTable dataTable = new DataTable();
            
            using (var connection = GetConnection())
            {
                connection.Open();
                using (var command = new NpgsqlCommand(query, connection))
                {
                    if (parameters != null)
                    {
                        command.Parameters.AddRange(parameters);
                    }
                    using (var reader = command.ExecuteReader())
                    {
                        dataTable.Load(reader);
                    }
                }
            }
            return dataTable;
        }

        public static int ExecuteNonQuery(string query, NpgsqlParameter[] parameters = null)
        {
            using (var connection = GetConnection())
            {
                connection.Open();
                using (var command = new NpgsqlCommand(query, connection))
                {
                    if (parameters != null)
                    {
                        command.Parameters.AddRange(parameters);
                    }
                    return command.ExecuteNonQuery();
                }
            }
        }
    }
}
private void BtnGenerateReport_Click(object sender, EventArgs e)
{
    int employeeId = Convert.ToInt32(cmbEmployeeFilter.SelectedValue);
    
    string query;
    NpgsqlParameter[] parameters;
    
    if (employeeId == -1) // Все сотрудники
    {
        query = @"
            SELECT 
                e.FullName AS ""Сотрудник"",
                COALESCE(SUM(ap.Amount), 0) AS ""Выдано всего"",
                COALESCE(SUM(CASE WHEN ap.IsTaxable = TRUE THEN ap.Amount ELSE 0 END), 0) AS ""Сумма, облагаемая налогом"",
                COALESCE(SUM(CASE WHEN ap.IsTaxable = TRUE THEN ap.Amount * 0.13 ELSE 0 END), 0) AS ""Сумма налога (13%)""
            FROM Employees e
            LEFT JOIN AdvancePayments ap ON e.EmployeeID = ap.EmployeeID 
                AND ap.PaymentDate BETWEEN @startDate AND @endDate
            GROUP BY e.EmployeeID, e.FullName
            ORDER BY e.FullName";
        
        parameters = new[]
        {
            new NpgsqlParameter("@startDate", dtpStartDate.Value),
            new NpgsqlParameter("@endDate", dtpEndDate.Value)
        };
    }
    else // Конкретный сотрудник
    {
        query = @"
            SELECT 
                e.FullName AS ""Сотрудник"",
                COALESCE(SUM(ap.Amount), 0) AS ""Выдано всего"",
                COALESCE(SUM(CASE WHEN ap.IsTaxable = TRUE THEN ap.Amount ELSE 0 END), 0) AS ""Сумма, облагаемая налогом"",
                COALESCE(SUM(CASE WHEN ap.IsTaxable = TRUE THEN ap.Amount * 0.13 ELSE 0 END), 0) AS ""Сумма налога (13%)""
            FROM Employees e
            LEFT JOIN AdvancePayments ap ON e.EmployeeID = ap.EmployeeID 
                AND ap.PaymentDate BETWEEN @startDate AND @endDate
            WHERE e.EmployeeID = @empId
            GROUP BY e.EmployeeID, e.FullName
            ORDER BY e.FullName";
        
        parameters = new[]
        {
            new NpgsqlParameter("@startDate", dtpStartDate.Value),
            new NpgsqlParameter("@endDate", dtpEndDate.Value),
            new NpgsqlParameter("@empId", employeeId)
        };
    }

    var dgvTaxReport = tabControl.TabPages[2].Controls["dgvTaxReport"] as DataGridView;
    var result = DatabaseHelper.ExecuteQuery(query, parameters);
    dgvTaxReport.DataSource = result;
    dgvTaxReport.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill;
}
private void LoadEmployeeFilter()
{
    string query = "SELECT EmployeeID, FullName FROM Employees ORDER BY FullName";
    var dt = DatabaseHelper.ExecuteQuery(query);
    
    // Создаем новую таблицу для комбобокса с опцией "Все сотрудники"
    DataTable filterDt = new DataTable();
    filterDt.Columns.Add("EmployeeID", typeof(object));
    filterDt.Columns.Add("FullName", typeof(string));
    
    // Добавляем "Все сотрудники" первой строкой
    DataRow allRow = filterDt.NewRow();
    allRow["EmployeeID"] = -1;  // Используем -1 для "Всех сотрудников"
    allRow["FullName"] = "--- Все сотрудники ---";
    filterDt.Rows.Add(allRow);
    
    // Добавляем всех сотрудников
    foreach (DataRow row in dt.Rows)
    {
        DataRow newRow = filterDt.NewRow();
        newRow["EmployeeID"] = row["EmployeeID"];
        newRow["FullName"] = row["FullName"];
        filterDt.Rows.Add(newRow);
    }
    
    cmbEmployeeFilter.DataSource = filterDt;
    cmbEmployeeFilter.DisplayMember = "FullName";
    cmbEmployeeFilter.ValueMember = "EmployeeID";
}
public static DataTable ExecuteQuery(string query, NpgsqlParameter[] parameters = null)
{
    DataTable dataTable = new DataTable();
    
    try
    {
        using (var connection = GetConnection())
        {
            connection.Open();
            
            using (var command = new NpgsqlCommand(query, connection))
            {
                // Добавляем параметры, если они есть
                if (parameters != null && parameters.Length > 0)
                {
                    foreach (var param in parameters)
                    {
                        // Важно: явно указываем тип данных для параметров
                        if (param.Value == null || param.Value == DBNull.Value)
                        {
                            param.Value = DBNull.Value;
                            param.NpgsqlDbType = NpgsqlTypes.NpgsqlDbType.Integer; // Для ID
                        }
                        command.Parameters.Add(param);
                    }
                }
                
                using (var reader = command.ExecuteReader())
                {
                    dataTable.Load(reader);
                }
            }
        }
    }
    catch (NpgsqlException ex)
    {
        MessageBox.Show($"Ошибка базы данных: {ex.Message}\nЗапрос: {query}", 
            "Ошибка SQL", MessageBoxButtons.OK, MessageBoxIcon.Error);
        throw;
    }
    catch (Exception ex)
    {
        MessageBox.Show($"Ошибка выполнения запроса: {ex.Message}", 
            "Ошибка", MessageBoxButtons.OK, MessageBoxIcon.Error);
        throw;
    }
    
    return dataTable;
}
private void LoadEmployeeFilter()
{
    string query = "SELECT EmployeeID, FullName FROM Employees ORDER BY FullName";
    var dt = DatabaseHelper.ExecuteQuery(query);
    
    // Создаем новую таблицу с опцией "Все сотрудники"
    DataTable filterDt = new DataTable();
    filterDt.Columns.Add("EmployeeID", typeof(int));
    filterDt.Columns.Add("FullName", typeof(string));
    
    // Добавляем "Все сотрудники" (EmployeeID = 0)
    DataRow allRow = filterDt.NewRow();
    allRow["EmployeeID"] = 0;
    allRow["FullName"] = "Все сотрудники";
    filterDt.Rows.Add(allRow);
    
    // Добавляем всех сотрудников
    foreach (DataRow row in dt.Rows)
    {
        DataRow newRow = filterDt.NewRow();
        newRow["EmployeeID"] = Convert.ToInt32(row["EmployeeID"]);
        newRow["FullName"] = row["FullName"].ToString();
        filterDt.Rows.Add(newRow);
    }
    
    cmbEmployeeFilter.DataSource = filterDt;
    cmbEmployeeFilter.DisplayMember = "FullName";
    cmbEmployeeFilter.ValueMember = "EmployeeID";
}
